node start
  set gold "10" @2:1 "[let $gold = 10]"
  set name "\"Alice\"" @3:1 "[let $name = \"Alice\"]"
  line Alice "J'ai de l'or." @4:1 "Alice: J'ai de l'or."
  choice-group @5:1 "-> Dépenser\n    [let $gold = $gold - 5]\n    Alice: Il m'en reste.\n-> Garder\n    [let $greedy = true]"
    choice "Dépenser" @5:1 "-> Dépenser\n    [let $gold = $gold - 5]\n    Alice: Il m'en reste."
